# ========================================================
# Telegram Session Guard - Environment Configuration
# ========================================================

# Get your API_ID and API_HASH from https://my.telegram.org
API_ID=
API_HASH=

# Get your BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=

# 32-byte URL-safe base64-encoded key for encrypting stored session strings
# Leave blank on first run; the application will generate one and print it.
ENCRYPTION_KEY=

# Database file path (defaults to guard.db)
DATABASE_PATH=guard.db
